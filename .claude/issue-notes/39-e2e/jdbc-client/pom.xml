<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>local.athenajdbccheck</groupId>
  <artifactId>athena-jdbc-check</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- issue #39 実機検証: 公式 Athena JDBC ドライバ本体。
         Maven Central には 3.x 表記のバージョンは無く、同じドライバ系列（com.amazonaws:athena-jdbc）
         の calver 表記に切り替わっている。取れる最古のものを使う（2026-09-21 実測）。 -->
    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>athena-jdbc</artifactId>
      <version>2024.8.1</version>
    </dependency>
    <!-- ドライバのログ（INFO を含む）を標準エラーに出すため -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-deps</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
